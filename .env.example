# Copy this file to .env and fill in your real values.
# Find credentials in the Box Developer Console:
# https://cloud.app.box.com/developers/console

# CCG app credentials (Configuration tab)
BOX_CLIENT_ID=your_client_id
BOX_CLIENT_SECRET=your_client_secret

# Your enterprise ID (account icon > Copy Enterprise ID)
BOX_ENTERPRISE_ID=your_enterprise_id

# Knowledge Governance metadata template key (Admin Console > Metadata)
BOX_METADATA_TEMPLATE_KEY=your_template_key

# Domain staging / approved folder IDs (from Box folder URLs)
STAGING_FOLDER_ID=your_domain_staging_folder_id
APPROVED_FOLDER_ID=your_domain_approved_folder_id

# Optional: top-level Company Brain folder ID (scopes health.py queries)
# COMPANY_BRAIN_FOLDER_ID=your_company_brain_folder_id

# Set after intake: file to approve/publish
# FILE_ID=

# Publish settings
DOMAIN=security
CONTENT_OWNER=security-team@example.com

# Written automatically by publish.py when it creates a hub
# BOX_HUB_ID=
